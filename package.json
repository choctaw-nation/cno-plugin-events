{
	"name": "cno-plugin-events",
	"version": "5.0.0",
	"description": "Choctaw Events Plugin",
	"prettier": "@wordpress/prettier-config",
	"browserslist": [
		"extends @wordpress/browserslist-config"
	],
	"engines": {
		"node": ">= 24"
	},
	"author": "Choctaw Nation of Oklahoma",
	"scripts": {
		"build": "wp-scripts build",
		"lint:css": "npx stylelint '**/*.scss' '**/*.css' --fix --allow-empty-input",
		"lint:js": "npx eslint --fix",
		"packages-update": "wp-scripts packages-update",
		"plugin-zip": "wp-scripts build && wp-scripts plugin-zip",
		"start": "wp-scripts start"
	},
	"license": "GPL-3.0-or-later",
	"files": [
		"build",
		"vendor",
		"inc",
		"template-parts",
		"templates",
		"README.md",
		"CHANGELOG.md",
		"LICENSE",
		"cno-plugin-events.php"
	],
	"devDependencies": {
		"@wordpress/scripts": "^31.8.0"
	}
}
